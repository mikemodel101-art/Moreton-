# ---------------------------------------------------------------------------
# Moreton Wills Online — prototype environment
# Copy to .env and adjust. No real secrets belong in this repository.
# ---------------------------------------------------------------------------

# Signs the demo session cookie (HMAC). Any random string works locally.
SESSION_SECRET="change-me-to-a-long-random-string"

# Optional: a Postgres URL if you wire the Prisma/Drizzle model in Section 14.
# The prototype runs entirely on an in-memory seeded store, so this is unused.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# ---------------------------------------------------------------------------
# Stripe — TEST MODE ONLY. The prototype ships a faithful mock of Stripe
# Checkout; set these to run against real test-mode keys instead.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"

# Local webhook forwarding:
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
# Trigger a completed checkout:
#   stripe trigger checkout.session.completed
# If webhooks are unreachable, Admin → Pricing has a "simulate payment" fallback.

# ---------------------------------------------------------------------------
# Email — the prototype never sends mail. Every notification renders at /mail.
# ---------------------------------------------------------------------------
EMAIL_MODE="preview-only"
